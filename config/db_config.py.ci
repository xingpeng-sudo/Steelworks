"""CI环境数据库配置模板

使用说明:
1. 复制此文件为 db_config.py
2. 填入实际的数据库连接信息
3. 确保 db_config.py 在 .gitignore 中，不要提交到仓库
"""

# CI环境配置（使用GitHub Secrets）
STEELWORKS_DB = {
    "user": "${{ secrets.DB_USER }}",
    "password": "${{ secrets.DB_PASSWORD }}",
    "dsn": "${{ secrets.DB_DSN }}"
}

# 本地开发配置（覆盖上面的配置）
# STEELWORKS_DB = {
#     "user": "your_username",
#     "password": "your_password",
#     "dsn": "192.168.1.121:1521/ORCLPDB"
# }

DB_CONFIGS = {
    "test": STEELWORKS_DB,
}
